        {"type": "text", "x": 118, "y": 320, "text": "0.645V", "font": "mono", "size": 15, "color": "muted", "align": "right"},
        {"type": "text", "x": 118, "y": 393, "text": "0.483V", "font": "mono", "size": 15, "color": "muted", "align": "right"},
        {"type": "text", "x": 118, "y": 466, "text": "0.322V", "font": "mono", "size": 15, "color": "muted", "align": "right"},
