         "rich": [
           {"text": "10  板级外设", "font": "msyhbd", "size": 20, "color": "dark"},
           {"text": "LED / KEY / SDRAM", "font": "mono", "size": 14, "color": "text"},
           {"text": "LCD / ADC1", "font": "mono", "size": 14, "color": "text"}
