        {"type": "text", "x": 60, "y": 82, "text": "关键路径：启动文件 → 系统时钟 180 MHz → TIM9_CH2(PA3) → while(1)", "size": 18, "color": "muted"},

        {"type": "box", "x": 50, "y": 130, "w": 290, "h": 116, "pad": 14,
         "rich": [
           {"text": "01  上电复位", "font": "msyhbd", "size": 21, "color": "dark"},
           {"text": "MSP=__initial_sp", "font": "mono", "size": 15, "color": "muted"},
           {"text": "PC=Reset_Handler", "font": "mono", "size": 15, "color": "muted"}
         ]},
        {"type": "box", "x": 375, "y": 130, "w": 290, "h": 116, "pad": 14,
         "rich": [
           {"text": "02  Reset_Handler", "font": "msyhbd", "size": 20, "color": "dark"},
           {"text": "SystemInit", "font": "mono", "size": 15, "color": "text"},
           {"text": "__main → main()", "font": "mono", "size": 15, "color": "text"}
         ]},
        {"type": "box", "x": 700, "y": 130, "w": 290, "h": 116, "pad": 14,
         "rich": [
           {"text": "03  SystemInit", "font": "msyhbd", "size": 20, "color": "dark"},
           {"text": "FPU CP10/CP11 使能", "font": "msyh", "size": 15, "color": "text"},
           {"text": "VTOR = 0x08000000", "font": "mono", "size": 15, "color": "muted"}
         ]},
        {"type": "box", "x": 1025, "y": 130, "w": 290, "h": 116, "pad": 14,
         "rich": [
           {"text": "04  __main", "font": "msyhbd", "size": 20, "color": "dark"},
           {"text": ".data 复制到 RAM", "font": "msyh", "size": 15, "color": "text"},
           {"text": ".bss 清零", "font": "msyh", "size": 15, "color": "text"}
