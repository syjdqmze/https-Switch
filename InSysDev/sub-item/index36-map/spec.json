        {"type": "arrow", "points": [[340, 358], [375, 358]], "color": "dark", "width": 4},
        {"type": "arrow", "points": [[665, 358], [700, 358]], "color": "dark", "width": 4},
        {"type": "arrow", "points": [[990, 358], [1025, 358]], "color": "dark", "width": 4},
        {"type": "arrow", "points": [[1315, 358], [1350, 358]], "color": "dark", "width": 4},

        {"type": "dashed", "points": [[1495, 416], [1495, 442], [195, 442], [195, 460]], "color": "orange", "width": 3},
